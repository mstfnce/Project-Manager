    <UserSecretsId>44b56f5c-894b-43a8-a98b-f1d71a8ae0a4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
